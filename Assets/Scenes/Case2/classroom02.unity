  dialoguePanel: {fileID: 1491968014}
  dialogueText: {fileID: 1990254639}
  dialogueLines:
  - "\u5927\u5BB6\u597D\uFF0C\u6211\u662F\u300A\u7BA1\u7406\u8CC7\u8A0A\u7CFB\u7D71\u300B\u9019\u9580\u8AB2\u7684\u6559\u6388"
  - "\u5728\u4E0A\u8AB2\u4E4B\u524D\uFF0C\u5927\u5BB6\u9700\u8981\u5148\u4E86\u89E3...#%^$^&%^*$^"
  - "...\u57FA\u672C\u4E0A\u5C31\u662F\u9019\u6A23\uFF0C\u53E6\u5916\uFF0C\u9019\u9580\u8AB2\u6709\u6307\u5B9A\u7684\u539F\u6587\u66F8\uFF0C\u5927\u5BB6\u5225\u5FD8\u4E86\u5728\u4E0B\u6B21\u4E0A\u8AB2\u524D\u6E96\u5099\u597D"
  playerDialoguePanel: {fileID: 1213158211}
  playerDialogueText: {fileID: 1058454266}
  playerDialogueLines:
  - "\u641E\u4EC0\u9EBC\u9B3C\u554A\uFF01\u5DE5\u8CC7\u7CFB\u7B2C\u4E00\u5929\u958B\u5B78\uFF0C\u9019\u672C\u539F\u6587\u66F8\u4E00\u672C\u8981
    3,500 \u53F0\u5E63\uFF1F\uFF01"
  - "\u6211\u7B97\u4E00\u4E0B\u2026\u2026\u6211\u6263\u6389\u4F4F\u5BBF\u8CBB\u5F8C\uFF0C\u53E3\u888B\u88E1\u5168\u90E8\u7684\u751F\u6D3B\u8CBB\u53EA\u5269\u4E0B
    500 \u584A\u6B38\uFF01"
  - "\u8CB7\u5B8C\u9019\u672C\u66F8\uFF0C\u6211\u63A5\u4E0B\u4F86\u9019\u500B\u6708\u8981\u53BB\u53F0\u5357\u8DEF\u908A\u5403\u571F\u55CE\uFF1F\uFF01"
  - "\u53EF\u662F\u671F\u672B\u8003\u4E00\u5B9A\u8981\u7528\u9019\u672C\u66F8\u554A\uFF0C\u5982\u679C\u4E0D\u5F04\u5230\u4E00\u672C\uFF0C\u6211\u9019\u9580\u8AB2\u7D55\u5C0D\u88AB\u6559\u6388\u5237\u6389\uFF01"
